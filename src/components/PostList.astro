---
import { formatDate, getTagSlug, type Post } from "../lib/posts";

type Props = {
  posts: Post[];
};

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <div class="post-line">
          <a class="post-title" href={post.url}>{post.frontmatter.title}</a>
          <time datetime={new Date(post.frontmatter.pubDate).toISOString()}>
            {formatDate(post.frontmatter.pubDate)}
          </time>
        </div>
        <p>{post.frontmatter.description}</p>
        {
          post.frontmatter.tags?.length > 0 && (
            <div class="post-tags">
              {post.frontmatter.tags.map((tag) => (
                <a href={`/tags/${getTagSlug(tag)}/`}>{tag}</a>
              ))}
            </div>
          )
        }
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--line);
    padding: 24px 0;
  }

  .post-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
  }

  .post-title {
    font-size: 1.12rem;
    font-weight: 700;
    text-decoration: none;
  }

  time {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.9rem;
  }

  p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .post-tags a {
    color: var(--muted);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .post-tags a::before {
    content: "#";
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .post-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
