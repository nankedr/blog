---
import { SITE, navItems } from "../consts";

type Props = {
  title?: string;
  description?: string;
  wide?: boolean;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  structuredData?: Record<string, unknown>;
};

const title = Astro.props.title ? `${Astro.props.title} | ${SITE.title}` : SITE.title;
const description = Astro.props.description ?? SITE.description;
const wide = Astro.props.wide ?? false;
const type = Astro.props.type ?? "website";
const site = Astro.site ?? Astro.url.origin;
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site);
const image = new URL(Astro.props.image ?? "/og-default.png", site);
const websiteData = {
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: new URL("/", site).href,
  inLanguage: "zh-CN"
};
const graph = Astro.props.structuredData ? [websiteData, Astro.props.structuredData] : [websiteData];
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111312" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title} 分享封面`} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      type === "article" && Astro.props.publishedTime && (
        <meta
          property="article:published_time"
          content={new Date(Astro.props.publishedTime).toISOString()}
        />
      )
    }
    {
      type === "article" && Astro.props.modifiedTime && (
        <meta
          property="article:modified_time"
          content={new Date(Astro.props.modifiedTime).toISOString()}
        />
      )
    }
    {
      type === "article" &&
        Astro.props.tags?.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
  </head>
  <body class:list={{ wide }}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={SITE.title}>
        <span class="brand-mark">B</span>
        <span>{SITE.title}</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {year} {SITE.author}</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fbfbfa;
    --text: #171717;
    --muted: #686868;
    --line: #e8e6e1;
    --accent: #14746f;
    --accent-strong: #0c5f5b;
    --accent-soft: #e5f3f1;
    --code-bg: #f2f2ef;
    --max: 720px;
    --wide-max: 1120px;
    --shadow: 0 18px 50px rgb(24 37 34 / 7%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    margin: 0;
    background:
      radial-gradient(circle at 50% -180px, var(--accent-soft), transparent 430px),
      var(--bg);
    color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    line-height: 1.75;
    letter-spacing: 0;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-underline-offset: 0.22em;
  }

  a:hover {
    color: var(--accent);
  }

  :focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  ::selection {
    background: var(--accent-soft);
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: 12px;
    left: 50%;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    padding: 7px 12px;
    font-size: 0.88rem;
    text-decoration: none;
    transform: translate(-50%, -160%);
  }

  .skip-link:focus {
    color: var(--bg);
    transform: translate(-50%, 0);
  }

  main,
  .site-header,
  .site-footer {
    width: min(var(--max), calc(100% - 40px));
    margin: 0 auto;
  }

  body.wide main,
  body.wide .site-header,
  body.wide .site-footer {
    width: min(var(--wide-max), calc(100% - 48px));
  }

  main {
    flex: 1 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0 56px;
  }

  .brand,
  .site-nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 7px;
    background: var(--text);
    color: var(--bg);
    font-size: 15px;
    line-height: 1;
  }

  .site-nav a,
  .site-footer a {
    color: var(--muted);
    font-size: 15px;
    text-decoration: none;
  }

  .site-nav a[aria-current="page"] {
    color: var(--text);
    font-weight: 650;
  }

  h1,
  h2,
  h3 {
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(2.35rem, 9vw, 4.6rem);
  }

  h2 {
    margin: 52px 0 16px;
    font-size: 1.35rem;
  }

  h3 {
    margin: 36px 0 12px;
    font-size: 1.1rem;
  }

  p {
    margin: 0 0 18px;
  }

  li::marker {
    color: var(--accent);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  code {
    border-radius: 5px;
    background: var(--code-bg);
    padding: 0.15em 0.35em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  pre {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    background: var(--code-bg);
    line-height: 1.6;
  }

  pre code {
    background: transparent;
    padding: 0;
  }

  blockquote {
    margin: 28px 0;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 0 10px 10px 0;
    padding: 18px 20px;
    background: color-mix(in srgb, var(--accent-soft) 45%, transparent);
    color: var(--muted);
  }

  blockquote > :last-child {
    margin-bottom: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.93rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--line);
    padding: 11px 12px;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: color-mix(in srgb, var(--code-bg) 70%, transparent);
    font-weight: 650;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 48px 0;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    margin-top: 72px;
    padding: 28px 0 42px;
    color: var(--muted);
    font-size: 15px;
  }

  .lead {
    color: var(--muted);
    font-size: 1.08rem;
  }

  .kicker {
    margin-bottom: 14px;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    border-bottom: 1px solid var(--line);
    margin-top: 64px;
    padding-bottom: 12px;
  }

  .section-head h2 {
    margin: 0;
  }

  .muted {
    color: var(--muted);
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #111312;
      --text: #f3f0eb;
      --muted: #aaa59d;
      --line: #2b2e2c;
      --accent: #7ccbc2;
      --accent-strong: #a5e1da;
      --accent-soft: #143733;
      --code-bg: #1b1e1d;
      --shadow: 0 18px 50px rgb(0 0 0 / 22%);
    }

    .astro-code,
    .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 640px) {
    body {
      font-size: 16px;
    }

    main,
    .site-header,
    .site-footer,
    body.wide main,
    body.wide .site-header,
    body.wide .site-footer {
      width: min(var(--max), calc(100% - 28px));
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding-bottom: 40px;
    }

    .site-nav {
      flex-wrap: wrap;
    }

    table {
      display: block;
      overflow-x: auto;
    }
  }
</style>
