---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, getTagSlug } from "../lib/posts";
import type { MarkdownHeading } from "astro";

const { frontmatter, headings = [] } = Astro.props as {
  frontmatter: Record<string, any>;
  headings: MarkdownHeading[];
};
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} wide>
  <article class="article">
    <header class="article-header">
      <a class="back-link" href="/posts/">文章</a>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.description}</p>
      <div class="article-meta">
        <time datetime={new Date(frontmatter.pubDate).toISOString()}>
          {formatDate(frontmatter.pubDate)}
        </time>
        {
          frontmatter.updatedDate && (
            <span>更新于 {formatDate(frontmatter.updatedDate)}</span>
          )
        }
      </div>
      {
        frontmatter.tags?.length > 0 && (
          <div class="tags" aria-label="文章标签">
            {frontmatter.tags.map((tag: string) => (
              <a href={`/tags/${getTagSlug(tag)}/`}>{tag}</a>
            ))}
          </div>
        )
      }
    </header>
    {
      toc.length > 0 && (
        <aside class="toc-wrap" aria-label="文章目录">
          <details class="toc" open>
            <summary>目录</summary>
            <nav>
              {toc.map((heading) => (
                <a class:list={{ sub: heading.depth === 3 }} href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              ))}
            </nav>
          </details>
        </aside>
      )
    }
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const sections = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length) {
    const setActive = (id: string) => {
      links.forEach((link) =>
        link.toggleAttribute("aria-current", decodeURIComponent(link.hash.slice(1)) === id)
      );
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).at(-1);
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: "-15% 0px -75%" }
    );
    sections.forEach((section) => observer.observe(section));
    setActive(sections[0].id);
  }
</script>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 760px) 220px;
    justify-content: space-between;
    column-gap: 64px;
  }

  .article-header {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--line);
    padding-bottom: 28px;
  }

  .article-header h1 {
    max-width: none;
    font-size: clamp(1.75rem, 2.4vw, 2rem);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tags a {
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 3px 10px;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .article-body {
    grid-column: 1;
    min-width: 0;
    padding-top: 34px;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 28px;
  }

  .article-body :global(h1) {
    margin-bottom: 24px;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
  }

  .article-body :global(h2) {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .article-body :global(a) {
    text-decoration-thickness: 1px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.4em;
  }

  .toc-wrap {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    position: sticky;
    top: 28px;
    padding-top: 34px;
  }

  .toc {
    border-left: 1px solid var(--line);
    padding-left: 18px;
  }

  .toc summary {
    margin-bottom: 12px;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc nav {
    display: grid;
    gap: 2px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .toc a {
    border-radius: 6px;
    color: var(--muted);
    padding: 5px 8px;
    font-size: 0.82rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 160ms ease, background 160ms ease;
  }

  .toc a:hover,
  .toc a[aria-current] {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .toc a.sub {
    padding-left: 20px;
    font-size: 0.78rem;
  }

  @media (max-width: 940px) {
    .article {
      display: block;
      max-width: 760px;
      margin: 0 auto;
    }

    .toc-wrap {
      position: static;
      padding-top: 28px;
    }

    .toc {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px 16px;
      background: color-mix(in srgb, var(--code-bg) 55%, transparent);
    }

    .toc summary {
      margin: 0;
      cursor: pointer;
    }

    .toc[open] summary {
      margin-bottom: 10px;
    }

    .toc nav {
      max-height: 320px;
    }
  }
</style>
